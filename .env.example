# Every provider below is used on its free plan or needs no key at all.

# CoinGecko Demo API key (free): https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# Etherscan API V2 key (free): https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Moralis API key (free plan, 40k compute units/day): https://admin.moralis.com
MORALIS_API_KEY=

# OpenSea API key (free): https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=

# Optional. Ethplorer key (free). Leave empty to use the public "freekey".
ETHPLORER_API_KEY=

# Optional. Ethereum JSON-RPC URL. Leave empty to use the free public node
# (https://ethereum-rpc.publicnode.com), or paste a free-tier Alchemy/Infura/QuickNode URL.
ETH_RPC_URL=

# Optional. Beacon API URL. Leave empty to use the free public node
# (https://ethereum-beacon-api.publicnode.com).
BEACON_API_URL=

# Groq API key (free tier), powers AI market insights: https://console.groq.com/keys
GROQ_API_KEY=

# Resend API key (free tier) and the inbox that receives feedback: https://resend.com
RESEND_API_KEY=
PERSONAL_EMAIL=

# Optional. Umami analytics
UMAMI_URL=
UMAMI_DATA_WEBSITE_ID=
