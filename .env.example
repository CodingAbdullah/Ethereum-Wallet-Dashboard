# Every provider below is used on its free plan or needs no key at all.

# CoinGecko Demo API key (free): https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# Etherscan API V2 key (free): https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Moralis API key (free plan, 40k compute units/day): https://admin.moralis.com
MORALIS_API_KEY=

# OpenSea API key (free): https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=

# Optional. Ethplorer key (free). Leave empty to use the public "freekey".
ETHPLORER_API_KEY=

# Optional. Ethereum JSON-RPC URL. Leave empty to use the free public node
# (https://ethereum-rpc.publicnode.com), or paste a free-tier Alchemy/Infura/QuickNode URL.
ETH_RPC_URL=

# Optional. RPC URLs for the other chains (simulations and on-chain reads for swaps, sends, staking...).
# Leave empty to use each chain's free public RPC. One per chain: RPC_URL_BASE, RPC_URL_ARBITRUM,
# RPC_URL_OPTIMISM, RPC_URL_POLYGON, RPC_URL_LINEA, RPC_URL_SEPOLIA, RPC_URL_HOODI.
RPC_URL_BASE=

# Optional. Beacon API URL. Leave empty to use the free public node
# (https://ethereum-beacon-api.publicnode.com).
BEACON_API_URL=

# Groq API key (free tier), powers AI market insights and the "Ask ETH Dashboard" assistant: https://console.groq.com/keys
GROQ_API_KEY=

# Resend API key (free tier) and the inbox that receives feedback: https://resend.com
RESEND_API_KEY=
PERSONAL_EMAIL=

# Optional. Upstash Redis (free tier) makes the API rate limit shared across all server instances.
# Without it, each instance keeps its own in-memory count. https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Sentry error monitoring (free Developer plan). Leave the DSN empty to turn Sentry off.
# https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=
# Optional. Only needed to upload source maps at build time (readable stack traces).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional. Umami analytics
UMAMI_URL=
UMAMI_DATA_WEBSITE_ID=

# --- Phase 1: wallet connection and accounts ---

# Optional. Reown project ID (free), turns on WalletConnect (mobile wallets by QR code): https://cloud.reown.com
# Without it, browser-extension wallets (MetaMask, Rabby, ...) and Coinbase Wallet still connect.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Neon Postgres connection string (free tier): https://console.neon.tech
# Create the tables once with: DATABASE_URL=... npm run db:migrate
# Without it, sign-in still works but saved wallets and /me are unavailable.
DATABASE_URL=

# Secret that signs the session cookie (32+ characters). Generate one with: openssl rand -base64 32
# Without it, the Sign in option is hidden.
AUTH_SECRET=

# Secret for scheduled jobs: Vercel sends it to the daily portfolio-snapshot job (see vercel.json), and the
# n8n scheduler sends it to the alert checks (Phase 3). Any random string.
# Without it, those routes return 503: the chart only gets a point when /me is opened, and no alerts run.
CRON_SECRET=

# --- Phase 3: alerts ---
# Alerts need DATABASE_URL and AUTH_SECRET (above). The checks are run on a schedule by n8n
# (n8n/alerts-scheduler.json) calling /api/cron/alerts/<type> with "Authorization: Bearer <CRON_SECRET>".

# Optional. n8n webhook that delivers alerts (n8n/alerts-router.json), and the secret that signs them.
# Without them, the app sends alerts to Telegram / Discord / email itself.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Telegram bot from @BotFather (free). The username is shown in the "link Telegram" button.
# The webhook secret is any random string, registered with setWebhook (see n8n/README.md).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Sender address for email alerts, on a domain verified in Resend (uses RESEND_API_KEY above)
ALERTS_FROM_EMAIL=

# Optional. Moralis Streams (free plan) pushes wallet activity and approvals the moment they happen.
# Without it, those alerts are checked every 10 / 30 minutes instead.
MORALIS_STREAM_ID=
MORALIS_STREAMS_SECRET=

# --- Phase 4: AI layer ---
# The MCP server (/api/mcp) and its API keys need DATABASE_URL and AUTH_SECRET (above); run npm run db:migrate
# once for the api_keys tables. The assistant needs GROQ_API_KEY (above).

# Optional. Groq model for the assistant. Leave empty for llama-3.3-70b-versatile (free tier).
AGENT_MODEL=

# --- Set these on the n8n server, not in this app (reference only; see n8n/README.md) ---
# APP_URL=https://ethereumdashboard.dev        # where the scheduler sends its checks
# N8N_WEBHOOK_SECRET=                          # same value as above, used to check alert signatures
# ALERTS_FROM_EMAIL=                           # same value as above, the sender for email alerts
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false           # lets the workflows read the three values above
